# 로컬 개발 전용 예시 값이다. 이 값들은 가짜이고, 실제 환경(클라우드)에서는 절대 쓰지 않는다.
# 사용법: 이 파일을 infra/.env로 복사한다. .env는 .gitignore에 있어 저장소에 올라가지 않는다.
# 진짜 비밀번호를 이 파일(.env.example)에 적지 않는다. (위협 모델 T9)

POSTGRES_DB=pqc
POSTGRES_USER=pqc_app
POSTGRES_PASSWORD=change-me-local-only

REDIS_PASSWORD=change-me-local-only

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-only
